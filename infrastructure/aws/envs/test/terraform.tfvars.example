# Copy this file to terraform.tfvars (gitignored) and fill in real values.

aws_region     = "eu-central-1"
domain_name    = "test.paulserban.eu"
# Optional overrides (defaults match these values):
# blog_domain_name = "test.blog.paulserban.eu"
# quiz_domain_name = "test.quiz.paulserban.eu"
# news_domain_name = "test.news-feed.paulserban.eu"
hosted_zone_id = "ZXXXXXXXXXXXXXX" # aws route53 list-hosted-zones-by-name --dns-name paulserban.eu

# HTTP Basic Auth enforced by a CloudFront Function (viewer-request) on all four sites.
basic_auth_username = "test"
basic_auth_password = "change-me"
