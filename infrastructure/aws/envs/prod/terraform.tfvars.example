# Copy this file to terraform.tfvars (gitignored) and fill in real values.

aws_region     = "eu-central-1"
domain_name    = "paulserban.eu"
# www_domain_name aliases to the same CloudFront distribution as domain_name.
# www_domain_name = "www.paulserban.eu"
# Optional overrides (defaults match these values):
# blog_domain_name = "blog.paulserban.eu"
# quiz_domain_name = "quiz.paulserban.eu"
# news_domain_name = "news-feed.paulserban.eu"
# news_data_domain_name = "news-data.paulserban.eu"
hosted_zone_id = "ZXXXXXXXXXXXXXX" # aws route53 list-hosted-zones-by-name --dns-name paulserban.eu

# Bing Webmaster Tools / IndexNow CNAME: {name}.paulserban.eu -> verify.bing.com
# bing_site_verification_cname_name = "2ec0a14cd64662ec65477e7a2a2751e4"

# Reuse the IAM OIDC provider created by envs/test (default is already false).
# create_oidc_provider = false
