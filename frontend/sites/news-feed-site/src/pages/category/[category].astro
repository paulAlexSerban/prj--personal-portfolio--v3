---
import { NewsFeedApp } from '@/library/modules/NewsFeedApp.tsx';
import BaseLayout from '@/system/templates/BaseTemplate.astro';
import { loadNewsIndex } from '@/lib/loadNewsIndex.ts';

export async function getStaticPaths() {
    const index = await loadNewsIndex();
    return index.categories.map((category) => ({
        params: { category: category.slug },
        props: { label: category.label },
    }));
}

const category = Astro.params.category!;
const { label } = Astro.props;
---

<BaseLayout
    title={`${label} News | Paul Serban`}
    description={`Software engineering headlines in ${label}.`}
>
    <NewsFeedApp client:load category={category} categoryLabel={label} />
</BaseLayout>
