---
import { NewsFeedApp } from '@/library/modules/NewsFeedApp.tsx';
import BaseLayout from '@/system/templates/BaseTemplate.astro';
import { CATEGORY_ORDER, categoryLabel } from '@/lib/queries/news.ts';

export function getStaticPaths() {
    return CATEGORY_ORDER.map((category) => ({ params: { category } }));
}

const category = Astro.params.category!;
const label = categoryLabel(category);
---

<BaseLayout
    title={`${label} News | Paul Serban`}
    description={`Software engineering headlines in ${label}.`}
>
    <NewsFeedApp client:load category={category} />
</BaseLayout>
