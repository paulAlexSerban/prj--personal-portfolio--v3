---
import NewsCard from '@/library/modules/NewsCard.astro';
import { NewsPagination } from '@/library/modules/NewsPagination.tsx';
import BaseLayout from '@/system/templates/BaseTemplate.astro';
import { closeConnection, openDb } from '@/lib/db.ts';
import { countAllItems, getAllItems, getHomePagePaths, pageCount } from '@/lib/queries/news.ts';
import { PAGE_SIZE, siteUrls } from '@/lib/urls.ts';

export function getStaticPaths() {
    const db = openDb();
    const paths = getHomePagePaths(db, PAGE_SIZE);
    closeConnection(db);
    return paths.map(({ page }) => ({ params: { page } }));
}

const pageNum = Number(Astro.params.page);
const db = openDb();
const total = countAllItems(db);
const pages = pageCount(total, PAGE_SIZE);
const items = getAllItems(db, { limit: PAGE_SIZE, offset: (pageNum - 1) * PAGE_SIZE });
closeConnection(db);

if (!Number.isFinite(pageNum) || pageNum < 2 || pageNum > pages) {
    return Astro.redirect(siteUrls.home);
}
---

<BaseLayout
    title={`News Feed · Page ${pageNum} | Paul Serban`}
    description={`Software engineering news digest - page ${pageNum}.`}
>
    <section class="mb-10">
        <div class="mb-5 border-b-[3px] border-ink pb-2">
            <p class="kicker text-sm">Latest · Page {pageNum}</p>
            <h2 class="m-0 font-display text-4xl font-bold">Engineering Wire</h2>
        </div>

        <ul class="m-0 list-none columns-1 gap-5 p-0 sm:columns-2 lg:columns-3">
            {
                items.map((item) => (
                    <li class="mb-5 break-inside-avoid">
                        <NewsCard item={item} />
                    </li>
                ))
            }
        </ul>

        <div class="mt-10 border-t border-rule pt-4">
            <NewsPagination
                page={pageNum}
                pages={pages}
                total={total}
                prevHref={siteUrls.homePage(pageNum - 1)}
                nextHref={pageNum < pages ? siteUrls.homePage(pageNum + 1) : undefined}
            />
        </div>
    </section>
</BaseLayout>
