---
import { FooterSiteLinks, SocialLinks, buildSiteTabs } from '@prj--personal-portfolio--v3/shared--navigation';
import { NewsIntroTrigger } from '@/library/modules/NewsIntroTrigger.tsx';
import { CATEGORY_LABEL, CATEGORY_ORDER } from '@/lib/queries/news.ts';
import { externalLinkAttrs, siteUrls } from '@/lib/urls.ts';

const footerLinks = [
    { label: 'Latest', href: siteUrls.home },
    ...CATEGORY_ORDER.slice(0, 4).map((slug) => ({
        label: CATEGORY_LABEL[slug] ?? slug,
        href: siteUrls.category(slug),
    })),
];

const siteTabs = buildSiteTabs({
    portfolio: siteUrls.portfolio,
    blog: siteUrls.blog,
    quiz: siteUrls.quiz,
    news: siteUrls.home,
});

const year = new Date().getFullYear();
---

<footer class="mt-8 border-t-2 border-ink">
    <div class="root-box text-center">
        <nav aria-label="Footer" class="mb-3">
            <ul class="m-0 flex list-none flex-wrap justify-center gap-x-6 gap-y-3 p-0 text-[11px] smallcaps">
                {
                    footerLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="text-ink no-underline hover:underline"
                                {...externalLinkAttrs(link.href)}
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <div class="mb-3">
            <FooterSiteLinks activeSite="news" tabs={siteTabs} />
        </div>
        <div class="kicker mb-2 flex flex-col items-center justify-center gap-3 text-sm">
            <SocialLinks
                client:load
                linkClassName="inline-flex items-center text-ink no-underline text-sm hover:opacity-70"
            />
            <span>
                Paul Serban · Engineering Wire · {year}
                {' · '}
                <NewsIntroTrigger
                    client:load
                    className="kicker cursor-pointer border-0 bg-transparent p-0 text-sm text-ink underline decoration-rule underline-offset-2 hover:opacity-70"
                />
            </span>
        </div>
    </div>
</footer>
