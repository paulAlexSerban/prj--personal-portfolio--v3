---
import SiteFooter from '@/library/modules/SiteFooter.astro';
import SiteHeader from '@/library/modules/SiteHeader.astro';
import { assetUrl } from '@/lib/urls.ts';

import '@/styles/global.css';

interface Props {
    title: string;
    description?: string;
    ogTitle?: string;
    ogDescription?: string;
    canonicalUrl?: string;
}

const { title, description, ogTitle = title, ogDescription = description, canonicalUrl } = Astro.props;

const pageDescription = description ?? 'Software engineering news digest by Paul Serban.';
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={pageDescription} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={ogDescription ?? pageDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <link rel="icon" href={assetUrl('favicon.ico')} sizes="any" />
        <link rel="icon" href={assetUrl('favicon.svg')} type="image/svg+xml" />
        <link rel="apple-touch-icon" href={assetUrl('apple-touch-icon.png')} />
        <link rel="canonical" href={canonical} />
        <link rel="sitemap" href={assetUrl('sitemap-index.xml')} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
            rel="stylesheet"
        />
        <slot name="head" />
    </head>
    <body class="min-h-screen bg-newsprint text-ink">
        <SiteHeader />
        <main class="root-box">
            <slot />
        </main>
        <SiteFooter />
        {
            cfBeaconToken && (
                <script
                    is:inline
                    defer
                    src="https://static.cloudflareinsights.com/beacon.min.js"
                    data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
                ></script>
            )
        }
    </body>
</html>
