---
import { evaluate } from '@mdx-js/mdx';
import { rehypePlugins, remarkPlugins } from '@prj--personal-portfolio--v3/shared--markdown/plugins';
import * as runtime from 'react/jsx-runtime';

import { coverImageUrl } from '@prj--personal-portfolio--v3/shared--ui/cover-image';

import HeroBanner from '@/library/modules/HeroBanner.astro';
import BaseLayout from '@/system/templates/BaseTemplate.astro';

import { closeConnection, openDb } from '@/lib/db.ts';
import { mdxComponents } from '@/lib/mdx-components.ts';
import {
    companionItemSlug,
    getCheatSheetsForPost,
    getLearningPlansForPost,
} from '@/lib/queries/companions.ts';
import {
    CONTENT_TYPE_LABEL,
    getAdjacentPosts,
    getPostBySlugAndType,
    getQuestionCountForPost,
    getTagsForPost,
    type BlogContentType,
} from '@/lib/queries/posts.ts';
import {
    assetUrl,
    cheatSheetDetailPath,
    learningPlanDetailPath,
    postDetailPath,
} from '@/lib/urls.ts';

interface Props {
    slug: string;
    contentType: BlogContentType;
}

const { slug, contentType } = Astro.props;

const db = openDb();
const post = getPostBySlugAndType(db, slug, contentType);
const tags = getTagsForPost(db, slug);
const questionCount = getQuestionCountForPost(db, slug);
const cheatSheets = getCheatSheetsForPost(db, slug);
const learningPlans = getLearningPlansForPost(db, slug);
const adjacent = getAdjacentPosts(db, slug, contentType);
closeConnection(db);

if (!post) {
    throw new Error(`${CONTENT_TYPE_LABEL[contentType]} not found: ${slug}`);
}

const { default: Content } = await evaluate(post.body, {
    ...runtime,
    remarkPlugins: [...remarkPlugins],
    rehypePlugins: [...rehypePlugins],
});

const description = post.excerpt ?? post.subheading ?? undefined;
const canonicalUrl = new URL(postDetailPath(contentType, slug), Astro.site).href;
const hasResources = cheatSheets.length > 0 || learningPlans.length > 0;
const ogImage = coverImageUrl(post.cover, assetUrl('og-default.png'));

function toIso(value: Date | string | null | undefined): string | undefined {
    if (!value) return undefined;
    const date = value instanceof Date ? value : new Date(value);
    return Number.isNaN(date.getTime()) ? undefined : date.toISOString();
}

const publishedTime = toIso(post.published_at) ?? toIso(post.date);
const modifiedTime = toIso(post.updated_at) ?? publishedTime;
---

<BaseLayout
    title={`${post.title} | Paul Serban`}
    description={description}
    ogTitle={post.title}
    ogDescription={description}
    canonicalUrl={canonicalUrl}
    ogImage={ogImage}
    ogType="article"
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    jsonLd={{
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: post.title,
        description,
        url: canonicalUrl,
        image: ogImage,
        datePublished: publishedTime,
        dateModified: modifiedTime,
        author: {
            '@type': 'Person',
            name: post.author ?? 'Paul Serban',
            url: 'https://paulserban.eu',
        },
    }}
>
    <HeroBanner
        title={post.title}
        subheading={post.subheading ?? undefined}
        tags={tags}
        cover={post.cover ?? undefined}
        kicker={post.date ?? undefined}
    />
    <article class="md-content mt-4">
        <Content components={mdxComponents} />
    </article>
    {
        questionCount > 0 && (
            <div
                id="quiz-widget-mount"
                class="quiz-widget-slot mt-12 min-h-16 border-2 border-dashed border-rule bg-highlight p-6"
                data-quiz-widget
                data-post-slug={post.slug}
            />
        )
    }
    {
        hasResources && (
            <section class="mt-12 border-t-[3px] border-ink pt-6">
                <h2 class="m-0 mb-4 font-display text-xl font-bold">Resources</h2>
                <ul class="m-0 flex list-none flex-col gap-2 p-0 sm:flex-row sm:flex-wrap">
                    {cheatSheets.map((sheet) => {
                        const itemSlug = companionItemSlug(sheet.slug, slug);
                        return (
                            <li>
                                <a
                                    href={cheatSheetDetailPath(contentType, slug, itemSlug)}
                                    class="inline-block border border-rule bg-highlight px-3 py-1.5 text-sm text-ink no-underline hover:border-ink"
                                >
                                    Cheat sheet: {sheet.title}
                                </a>
                            </li>
                        );
                    })}
                    {learningPlans.map((plan) => {
                        const itemSlug = companionItemSlug(plan.slug, slug);
                        return (
                            <li>
                                <a
                                    href={learningPlanDetailPath(contentType, slug, itemSlug)}
                                    class="inline-block border border-rule bg-highlight px-3 py-1.5 text-sm text-ink no-underline hover:border-ink"
                                >
                                    Learning plan: {plan.title}
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </section>
        )
    }
    {
        (adjacent.older || adjacent.newer) && (
            <nav
                class="mt-12 flex items-start justify-between gap-4 border-t-[3px] border-ink pt-6"
                aria-label="Post navigation"
            >
                <div class="max-w-[45%]">
                    {adjacent.older && (
                        <a
                            href={postDetailPath(contentType, adjacent.older.slug)}
                            class="group block text-ink no-underline"
                        >
                            <p class="kicker mb-1 text-[10px]">&larr; Older</p>
                            <p class="font-display font-bold group-hover:underline">{adjacent.older.title}</p>
                        </a>
                    )}
                </div>
                <div class="max-w-[45%] text-right">
                    {adjacent.newer && (
                        <a
                            href={postDetailPath(contentType, adjacent.newer.slug)}
                            class="group block text-ink no-underline"
                        >
                            <p class="kicker mb-1 text-[10px]">Newer &rarr;</p>
                            <p class="font-display font-bold group-hover:underline">{adjacent.newer.title}</p>
                        </a>
                    )}
                </div>
            </nav>
        )
    }
</BaseLayout>
