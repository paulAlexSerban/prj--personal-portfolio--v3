---
import { ImageZoomRoot } from '@prj--personal-portfolio--v3/shared--ui/image-zoom-root';

import SiteFooter from '@/library/modules/SiteFooter.astro';
import SiteHeader from '@/library/modules/SiteHeader.astro';

import { assetUrl } from '@/lib/urls.ts';
import '@/styles/global.css';

interface Props {
    title: string;
    description?: string;
    ogTitle?: string;
    ogDescription?: string;
    canonicalUrl?: string;
    ogImage?: string;
    ogType?: 'website' | 'article';
    publishedTime?: string;
    modifiedTime?: string;
    robots?: string;
    jsonLd?: object | object[];
}

const {
    title,
    description,
    ogTitle = title,
    ogDescription = description,
    canonicalUrl,
    ogImage = assetUrl('og-default.png'),
    ogType = 'website',
    publishedTime,
    modifiedTime,
    robots,
    jsonLd,
} = Astro.props;

const pageDescription = description ?? 'Paul Serban - engineer, architect, selected works.';
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = /^https?:\/\//i.test(ogImage) ? ogImage : new URL(ogImage, Astro.site).href;
const sitemapUrl = assetUrl('sitemap-index.xml');
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const siteUrl = Astro.site?.href ?? canonical;

const websiteLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Paul Serban',
    url: siteUrl,
};

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={pageDescription} />
        {robots && <meta name="robots" content={robots} />}
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={ogDescription ?? pageDescription} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImageUrl} />
        {ogType === 'article' && publishedTime && (
            <meta property="article:published_time" content={publishedTime} />
        )}
        {ogType === 'article' && modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime} />
        )}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={ogTitle} />
        <meta name="twitter:description" content={ogDescription ?? pageDescription} />
        <meta name="twitter:image" content={ogImageUrl} />
        <link rel="icon" href={assetUrl('favicon.ico')} sizes="any" />
        <link rel="icon" href={assetUrl('favicon.svg')} type="image/svg+xml" />
        <link rel="apple-touch-icon" href={assetUrl('apple-touch-icon.png')} />
        <link rel="canonical" href={canonical} />
        <link rel="sitemap" href={sitemapUrl} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
        {extraLd.map((block) => (
            <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
        ))}
        <slot name="head" />
    </head>
    <body class="body">
        <SiteHeader />
        <main class="root-box">
            <slot />
        </main>
        <SiteFooter />
        <ImageZoomRoot client:load />
        {
            cfBeaconToken && (
                <script
                    is:inline
                    defer
                    src="https://static.cloudflareinsights.com/beacon.min.js"
                    data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
                ></script>
            )
        }
    </body>
</html>
