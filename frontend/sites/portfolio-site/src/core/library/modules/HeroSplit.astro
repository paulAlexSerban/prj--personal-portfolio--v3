---
import type { ProfileRow } from '@prj--personal-portfolio--v3/shared--db-schema';
import { CoverImage } from '@prj--personal-portfolio--v3/shared--ui/cover-image-ui';
import { assetUrl, externalLinkAttrs, siteUrls } from '@/lib/urls.ts';

interface Props {
    profile: ProfileRow | undefined;
}

const PORTFOLIO_BANNER_COVER = 'portfolio-banner.ff0168fc';
const PLACEHOLDER_COVER = assetUrl('placeholder-cover.png');

const { profile } = Astro.props;
const name = profile?.name ?? 'Paul Serban';
const headline = profile?.headline ?? 'I architect systems that ship.';
---

<section class="mb-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
            <p class="kicker mb-2 text-sm">{name}</p>
            <h1 class="m-0 font-display text-[clamp(2.25rem,6vw,3.75rem)] font-bold leading-[1.05]">
                {headline}
            </h1>
            {profile?.bio && (
                <p class="deck mt-4 max-w-prose text-[1.05rem] line-clamp-3">{profile.bio}</p>
            )}
            <div class="mt-6 flex flex-wrap gap-3">
                <a class="stamp px-5 py-2 text-sm" href={siteUrls.portfolio}>View work &rarr;</a>
                <a class="stamp stamp-ghost px-5 py-2 text-sm" href={siteUrls.blog} {...externalLinkAttrs(siteUrls.blog)}>
                    Read blog &rarr;
                </a>
            </div>
        </div>
        <div class="group">
            <CoverImage
                client:load
                zoomable={true}
                zoomAlt="Paul Serban portfolio architecture banner"
                cover={PORTFOLIO_BANNER_COVER}
                placeholder={PLACEHOLDER_COVER}
                alt="Paul Serban portfolio architecture banner"
                loading="eager"
                sizes="(max-width: 1024px) 100vw, 50vw"
                ratiosStr="[0,0,0,0,0]"
                imgClassName="post-card-cover-img aspect-square w-full object-cover"
            />
        </div>
    </div>
    <div class="rule mt-10"></div>
</section>
